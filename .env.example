# Supabase (Next.js - browser-safe public values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# JANGAN menaruh service_role key di file yang di-commit atau variabel NEXT_PUBLIC_*.
# Jika butuh operasi admin/server khusus, simpan di environment server yang aman saja:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
